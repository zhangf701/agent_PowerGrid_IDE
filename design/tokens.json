{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "PowerMCP UI 设计令牌 —— 单一真源。规范文档 docs/PowerMCP_UI设计规范.md §三 的表格由本文件生成/校对。禁止只改文档不改本文件（用 tools/check_design_tokens.py 校验）。",
  "meta": {
    "version": "1.0.0",
    "date": "2026-09-24",
    "scope": "P1（契约引擎 T0+T2 · 契约面板 · 聊天面板 · 进程监管）",
    "source": "docs/PowerMCP_前端设计方案.md (v3)",
    "note": "semantic.light / semantic.dark 是被主题化的角色；primitive 与主题无关。"
  },

  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "50":  { "$value": "#F7F8FA" },
        "100": { "$value": "#EEF1F5" },
        "200": { "$value": "#DDE3EA" },
        "300": { "$value": "#C3CCD8" },
        "400": { "$value": "#97A3B4" },
        "500": { "$value": "#6B7686" },
        "600": { "$value": "#4A5464" },
        "700": { "$value": "#333B48" },
        "800": { "$value": "#1F2530" },
        "900": { "$value": "#12161D" }
      },
      "ink": {
        "950": { "$value": "#0A0D11" },
        "900": { "$value": "#0E1116" },
        "850": { "$value": "#14181F" },
        "800": { "$value": "#1A1F28" },
        "750": { "$value": "#222833" },
        "700": { "$value": "#2C3441" },
        "600": { "$value": "#3D4757" },
        "500": { "$value": "#6B7686" },
        "400": { "$value": "#97A3B4" },
        "300": { "$value": "#B8C2CF" },
        "200": { "$value": "#D6DDE6" },
        "100": { "$value": "#EDF1F6" }
      },
      "blue": {
        "50":  { "$value": "#EFF4FE" },
        "400": { "$value": "#60A5FA" },
        "500": { "$value": "#3B82F6" },
        "600": { "$value": "#2563EB" },
        "700": { "$value": "#1D4ED8" },
        "800": { "$value": "#1E40AF" },
        "900": { "$value": "#16233A" }
      },
      "green": {
        "50":  { "$value": "#E8F5EC" },
        "100": { "$value": "#10291B" },
        "300": { "$value": "#9BD3AE" },
        "400": { "$value": "#7BD9A0" },
        "500": { "$value": "#34D399" },
        "600": { "$value": "#2F6B47" },
        "700": { "$value": "#1B6B3A" }
      },
      "amber": {
        "50":  { "$value": "#FFF4E0" },
        "100": { "$value": "#2E2410" },
        "300": { "$value": "#F0C377" },
        "400": { "$value": "#FBBF24" },
        "600": { "$value": "#7A5A1E" },
        "700": { "$value": "#8A5A00" }
      },
      "red": {
        "50":  { "$value": "#FDEBEC" },
        "100": { "$value": "#33151A" },
        "300": { "$value": "#F0A3A8" },
        "400": { "$value": "#F87171" },
        "500": { "$value": "#F39AA2" },
        "600": { "$value": "#7E2F38" },
        "700": { "$value": "#A32A32" }
      },
      "violet": {
        "50":  { "$value": "#F3EEFB" },
        "300": { "$value": "#C4A8E8" },
        "400": { "$value": "#A78BFA" },
        "600": { "$value": "#7C3AED" },
        "700": { "$value": "#5B2C9E" },
        "900": { "$value": "#241A38" }
      },
      "cyan":   { "400": { "$value": "#22D3EE" }, "600": { "$value": "#0891B2" } },
      "pink":   { "400": { "$value": "#F472B6" }, "600": { "$value": "#DB2777" } },
      "lime":   { "400": { "$value": "#A3E635" }, "600": { "$value": "#65A30D" } },
      "stone":  { "400": { "$value": "#A8A29E" }, "600": { "$value": "#78716C" } }
    },

    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans SC\", \"Segoe UI\", Roboto, sans-serif" },
      "mono": { "$value": "\"JetBrains Mono\", \"Cascadia Code\", Consolas, \"SF Mono\", \"Liberation Mono\", monospace" }
    },

    "fontSize": {
      "$type": "dimension",
      "display": { "$value": "24px" },
      "h1":      { "$value": "20px" },
      "h2":      { "$value": "16px" },
      "body":    { "$value": "14px" },
      "bodySm":  { "$value": "13px" },
      "caption": { "$value": "12px" },
      "mono":    { "$value": "13px" }
    },

    "lineHeight": {
      "$type": "number",
      "display": { "$value": 1.33 },
      "h1":      { "$value": 1.4 },
      "h2":      { "$value": 1.5 },
      "body":    { "$value": 1.57 },
      "bodySm":  { "$value": 1.54 },
      "caption": { "$value": 1.5 },
      "mono":    { "$value": 1.54 }
    },

    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "semibold":{ "$value": 600 }
    },

    "space": {
      "$type": "dimension",
      "0":  { "$value": "0px" },
      "1":  { "$value": "4px" },
      "2":  { "$value": "8px" },
      "3":  { "$value": "12px" },
      "4":  { "$value": "16px" },
      "5":  { "$value": "20px" },
      "6":  { "$value": "24px" },
      "8":  { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "16": { "$value": "64px" }
    },

    "radius": {
      "$type": "dimension",
      "none": { "$value": "0px" },
      "sm":   { "$value": "4px" },
      "md":   { "$value": "6px" },
      "lg":   { "$value": "8px" },
      "xl":   { "$value": "12px" },
      "full": { "$value": "9999px" }
    },

    "borderWidth": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "thick":    { "$value": "2px" }
    },

    "shadow": {
      "$type": "shadow",
      "sm": { "$value": "0 1px 2px rgba(18, 22, 29, 0.06)" },
      "md": { "$value": "0 4px 12px rgba(18, 22, 29, 0.10)" },
      "lg": { "$value": "0 12px 32px rgba(18, 22, 29, 0.16)" }
    },

    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": "120ms" },
        "base": { "$value": "180ms" },
        "slow": { "$value": "280ms" }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
        "enter":    { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
        "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
      }
    },

    "zIndex": {
      "$type": "number",
      "base":     { "$value": 0 },
      "sticky":   { "$value": 1100 },
      "dropdown": { "$value": 1000 },
      "drawer":   { "$value": 1200 },
      "modal":    { "$value": 1300 },
      "toast":    { "$value": 1400 },
      "tooltip":  { "$value": 1500 }
    }
  },

  "semantic": {
    "light": {
      "surface": {
        "base":    { "$value": "{primitive.color.neutral.50}",  "$type": "color", "$description": "应用背景" },
        "raised":  { "$value": "#FFFFFF",                        "$type": "color", "$description": "卡片 / 面板 / 弹层" },
        "sunken":  { "$value": "{primitive.color.neutral.100}", "$type": "color", "$description": "内嵌区 / 代码块底" },
        "overlay": { "$value": "rgba(18, 22, 29, 0.45)",         "$type": "color", "$description": "模态遮罩" }
      },
      "text": {
        "primary":   { "$value": "{primitive.color.neutral.900}", "$type": "color" },
        "secondary": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
        "muted":     { "$value": "{primitive.color.neutral.500}", "$type": "color" },
        "inverse":   { "$value": "#FFFFFF",                       "$type": "color" }
      },
      "border": {
        "subtle":  { "$value": "{primitive.color.neutral.200}", "$type": "color" },
        "default": { "$value": "{primitive.color.neutral.300}", "$type": "color" },
        "strong":  { "$value": "{primitive.color.neutral.400}", "$type": "color" },
        "focus":   { "$value": "{primitive.color.blue.600}",    "$type": "color" }
      },
      "interactive": {
        "default": { "$value": "{primitive.color.blue.600}",    "$type": "color" },
        "hover":   { "$value": "{primitive.color.blue.700}",    "$type": "color" },
        "active":  { "$value": "{primitive.color.blue.800}",    "$type": "color" },
        "subtle":  { "$value": "{primitive.color.blue.50}",     "$type": "color" }
      },
      "contract": {
        "satisfied": { "bg": { "$value": "{primitive.color.green.50}", "$type": "color" }, "border": { "$value": "{primitive.color.green.300}", "$type": "color" }, "fg": { "$value": "{primitive.color.green.700}", "$type": "color" } },
        "degraded":  { "bg": { "$value": "{primitive.color.amber.50}", "$type": "color" }, "border": { "$value": "{primitive.color.amber.300}", "$type": "color" }, "fg": { "$value": "{primitive.color.amber.700}", "$type": "color" } },
        "violated":  { "bg": { "$value": "{primitive.color.red.50}",   "$type": "color" }, "border": { "$value": "{primitive.color.red.300}",   "$type": "color" }, "fg": { "$value": "{primitive.color.red.700}",   "$type": "color" } },
        "unknown":   { "bg": { "$value": "{primitive.color.neutral.100}", "$type": "color" }, "border": { "$value": "{primitive.color.neutral.300}", "$type": "color" }, "fg": { "$value": "{primitive.color.neutral.600}", "$type": "color" } },
        "incident":  { "bg": { "$value": "{primitive.color.violet.50}",  "$type": "color" }, "border": { "$value": "{primitive.color.violet.300}",  "$type": "color" }, "fg": { "$value": "{primitive.color.violet.700}",  "$type": "color" } }
      },
      "code": { "bg": { "$value": "#F4F6F9", "$type": "color" }, "fg": { "$value": "{primitive.color.neutral.800}", "$type": "color" } },
      "chart": {
        "grid": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
        "axis": { "$value": "{primitive.color.neutral.500}", "$type": "color" },
        "categorical": {
          "1": { "$value": "{primitive.color.blue.600}",   "$type": "color" },
          "2": { "$value": "#D97706",                      "$type": "color" },
          "3": { "$value": "#059669",                      "$type": "color" },
          "4": { "$value": "{primitive.color.violet.600}", "$type": "color" },
          "5": { "$value": "#DC2626",                      "$type": "color" },
          "6": { "$value": "{primitive.color.cyan.600}",   "$type": "color" },
          "7": { "$value": "{primitive.color.pink.600}",   "$type": "color" },
          "8": { "$value": "{primitive.color.lime.600}",   "$type": "color" },
          "9": { "$value": "{primitive.color.stone.600}",  "$type": "color" }
        }
      }
    },

    "dark": {
      "surface": {
        "base":    { "$value": "{primitive.color.ink.900}", "$type": "color" },
        "raised":  { "$value": "{primitive.color.ink.800}", "$type": "color" },
        "sunken":  { "$value": "{primitive.color.ink.950}", "$type": "color" },
        "overlay": { "$value": "rgba(0, 0, 0, 0.60)",        "$type": "color" }
      },
      "text": {
        "primary":   { "$value": "{primitive.color.ink.100}", "$type": "color" },
        "secondary": { "$value": "{primitive.color.ink.200}", "$type": "color" },
        "muted":     { "$value": "{primitive.color.ink.400}", "$type": "color" },
        "inverse":   { "$value": "{primitive.color.ink.900}", "$type": "color" }
      },
      "border": {
        "subtle":  { "$value": "{primitive.color.ink.700}", "$type": "color" },
        "default": { "$value": "{primitive.color.ink.600}", "$type": "color" },
        "strong":  { "$value": "{primitive.color.ink.500}", "$type": "color" },
        "focus":   { "$value": "{primitive.color.blue.400}", "$type": "color" }
      },
      "interactive": {
        "default": { "$value": "{primitive.color.blue.400}", "$type": "color" },
        "hover":   { "$value": "#7DB4FC",                     "$type": "color" },
        "active":  { "$value": "#93C5FD",                     "$type": "color" },
        "subtle":  { "$value": "{primitive.color.blue.900}", "$type": "color" }
      },
      "contract": {
        "satisfied": { "bg": { "$value": "{primitive.color.green.100}", "$type": "color" }, "border": { "$value": "{primitive.color.green.600}", "$type": "color" }, "fg": { "$value": "{primitive.color.green.400}", "$type": "color" } },
        "degraded":  { "bg": { "$value": "{primitive.color.amber.100}", "$type": "color" }, "border": { "$value": "{primitive.color.amber.600}", "$type": "color" }, "fg": { "$value": "{primitive.color.amber.300}", "$type": "color" } },
        "violated":  { "bg": { "$value": "{primitive.color.red.100}",   "$type": "color" }, "border": { "$value": "{primitive.color.red.600}",   "$type": "color" }, "fg": { "$value": "{primitive.color.red.500}",   "$type": "color" } },
        "unknown":   { "bg": { "$value": "#1F242E",                     "$type": "color" }, "border": { "$value": "{primitive.color.ink.600}",   "$type": "color" }, "fg": { "$value": "{primitive.color.ink.300}",   "$type": "color" } },
        "incident":  { "bg": { "$value": "{primitive.color.violet.900}", "$type": "color" }, "border": { "$value": "{primitive.color.violet.600}", "$type": "color" }, "fg": { "$value": "{primitive.color.violet.400}", "$type": "color" } }
      },
      "code": { "bg": { "$value": "{primitive.color.ink.850}", "$type": "color" }, "fg": { "$value": "{primitive.color.ink.200}", "$type": "color" } },
      "chart": {
        "grid": { "$value": "{primitive.color.ink.700}", "$type": "color" },
        "axis": { "$value": "{primitive.color.ink.500}", "$type": "color" },
        "categorical": {
          "1": { "$value": "{primitive.color.blue.400}",   "$type": "color" },
          "2": { "$value": "{primitive.color.amber.400}",  "$type": "color" },
          "3": { "$value": "{primitive.color.green.500}",  "$type": "color" },
          "4": { "$value": "{primitive.color.violet.400}", "$type": "color" },
          "5": { "$value": "{primitive.color.red.400}",    "$type": "color" },
          "6": { "$value": "{primitive.color.cyan.400}",   "$type": "color" },
          "7": { "$value": "{primitive.color.pink.400}",   "$type": "color" },
          "8": { "$value": "{primitive.color.lime.400}",   "$type": "color" },
          "9": { "$value": "{primitive.color.stone.400}",  "$type": "color" }
        }
      }
    }
  },

  "stateSignature": {
    "$description": "契约状态签名 —— 色 / 图标 / 标签三者绑定，不提供单独的颜色。依据方案 §五.1「颜色不得单独承载信息」。图标在形状上互不相似，去掉颜色或缩小后仍可区分。",
    "satisfied": { "icon": "✔", "label": "满足", "shortLabel": "满足" },
    "degraded":  { "icon": "▲", "label": "降级", "shortLabel": "降级" },
    "violated":  { "icon": "✖", "label": "违反", "shortLabel": "违反" },
    "unknown":   { "icon": "?", "label": "未知", "shortLabel": "未知",
                   "$description": "单条契约的未知态。展示层只有这一个 unknown 签名 —— structural / incident 的区分在数据模型与汇总层（见 unknownReason），不在视觉层再分叉。" },
    "incident":  { "icon": "!", "label": "事故", "shortLabel": "事故",
                   "$description": "系统级事故：契约引擎崩溃、或 SSE 边界 schema 校验失败。含义是「下面的契约状态整体不可信」，因此必须升至主徽章，不得降级为次级标记。" }
  },

  "unknownReason": {
    "$description": "未知态的两分。用途是汇总层区分「常态结构未知」与「偶发事故」—— 前者长期存在、无信息量，后者意味着整体不可信。",
    "structural": {
      "$description": "系统引擎级未知：引擎能力本身无法给出判定。典型为契约 4（状态映射）—— 方案 §11.1 已接受其长期降级为未知。",
      "$escalates": false,
      "examples": ["契约 4 无法推断引擎返回码语义", "OpenDSS 工具面未核实", "该引擎的编号约定未实测"]
    },
    "incident": {
      "$description": "偶发事故：本应能判定却拿不到判定。典型为契约引擎崩溃（方案 §11.3）与 SSE 边界 schema 校验失败。",
      "$escalates": true,
      "examples": ["契约引擎进程崩溃", "契约引擎熔断已打开", "SSE 事件未通过 Zod 校验"]
    }
  },

  "contractTypes": {
    "$description": "8 类契约的编号与名称 —— 与方案 §2.2 表格严格一致，不得自行增删。",
    "1": "API 版本契约",
    "2": "文档-实现一致性",
    "3": "参数契约",
    "4": "状态映射契约",
    "5": "命名空间契约",
    "6": "标识符契约",
    "7": "量纲契约",
    "8": "运行时依赖契约"
  },

  "identifierConvention": {
    "$description": "标识符编号约定。★ F-5（2026-09-26 实测裁定）：约定是「输出」的属性，不是「引擎」的属性 —— 同一引擎的不同输出约定不同（surge 的矩阵索引 0-based，其母线号输出 1-based）。查表规则：带输出键 → 只查 byOutput（按 server.tool.field，权威），未命中一律 unknown；不带输出键 → 回退 byEngine，其语义是「该引擎数据模型下标」。⚠️ 键必须使用 registry.py 的 server id（小写），不得用显示名 —— 大小写混写会导致查表未命中而静默标错约定，这正是方案 §五.3 规则 2 要防的 3.1 亿倍偏差。未实测的输出/引擎一律 unknown，禁止兜底为 0-based。",
    "byOutput": {
      "surge.run_ac_power_flow.bus_numbers":      "1-based",
      "surge.run_n1_branch_contingency.bus_number": "1-based"
    },
    "byEngine": {
      "pandapower": "0-based",
      "surge":      "0-based",
      "pypsa":      "1-based",
      "andes":      "unknown",
      "egret":      "unknown",
      "opendss":    "unknown",
      "hope":       "unknown",
      "genx":       "unknown",
      "powerio":    "unknown"
    },
    "suffix": {
      "0-based": "(0-based)",
      "1-based": "(1-based)",
      "unknown": "(约定未知)"
    },
    "$evidence": {
      "byOutput.surge.run_ac_power_flow.bus_numbers": "case118 实测（2026-09-26）：bus_numbers = 1…118（118 条，源文件编号）",
      "byOutput.surge.run_n1_branch_contingency.bus_number": "case118 N-1 实测（2026-09-26）：bus_number 出现 118，而 0-based 最大只能是 117 —— 决定性",
      "byEngine.pandapower": "case30 跨引擎比对实测：0-based 索引（数据模型下标）",
      "byEngine.surge":      "case30 PTDF/LODF 实测：矩阵索引 0-based（支路索引 12/15/33 与 pandapower 一致）—— ⚠️ 只对「矩阵索引」成立，母线号见 byOutput",
      "byEngine.pypsa":      "case30 跨引擎比对实测：沿用 IR 的 1-based 标识",
      "_others":             "未实测 —— 因此标 unknown 而非猜测值"
    }
  },

  "engineChartColor": {
    "$description": "引擎 → 图表分类色绑定。键为 server id。依据方案 §三「五面共享同一组件库」：同一引擎在所有呈现面必须同色。仅覆盖 P1 可见的 9 个开源引擎（方案 v3 已移除全部商业引擎）。",
    "pandapower": "cat-1",
    "pypsa":      "cat-2",
    "surge":      "cat-3",
    "andes":      "cat-4",
    "egret":      "cat-5",
    "hope":       "cat-6",
    "genx":       "cat-7",
    "opendss":    "cat-8",
    "powerio":    "cat-9"
  }
}
