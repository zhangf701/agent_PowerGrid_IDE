# 上游 clone —— 各自是独立的 git 仓库，绝不能记成 gitlink
/PowerMCP/
/PowerSkills/

# 大体积数据与中间产物
/GridData/
/work/
# PDF 生成流程的可再生中间产物（逐页校验 PNG / 中间稿 / 合并中间 PDF，
# 其中约 5.3MB 与 docs/ 下的正式 PDF 重复）—— 2026-09-24 经确认排除
/docs/_pdfwork/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
# 沙箱下 pytest 必须用项目内 basetemp（系统临时目录的清理会被拦截）
.pytest_tmp/

# 运行产物
*.log
gateway/.cache/
# vitest 的缓存目录（跑测试时在仓库根生成 .vite/vitest/results.json）—— 2026-09-27
/.vite/

# 例外：docs/logs/ 下的实测演示日志是证据链，需入库（须置于 *.log 之后）
!docs/logs/*.log

# SDD 进度台账（临时脚手架，不入库）
.superpowers/

# AI 助手的本机会话数据（记忆 / 技能 / 缓存）—— 不属于仓库内容
.claude/
.workbuddy/
.workbuddy-ai/
